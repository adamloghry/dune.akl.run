---
// Build-time generated pixel landscape: starfield, two moons, three dune layers.
// Deterministic (seeded), so every build is byte-identical — friendly to Nix and caching.
interface Props { seed?: number; height?: number; stars?: boolean }
const { seed = 10191, height = 96, stars = true } = Astro.props;

function rng(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const W = 320;
const H = height;
const r = rng(seed);

function layer(base: number, amp: number, step: number, phase: number) {
  const cols: { x: number; y: number }[] = [];
  const f1 = 0.02 + r() * 0.015, f2 = 0.05 + r() * 0.03;
  for (let x = 0; x < W; x += step) {
    const y = base - amp * (0.6 * Math.sin(x * f1 + phase) + 0.4 * Math.sin(x * f2 + phase * 2.3));
    cols.push({ x, y: Math.round(y) });
  }
  return cols;
}
const layers = [
  { cls: 'dune-3', cols: layer(H * 0.55, 10, 2, r() * 6) },
  { cls: 'dune-2', cols: layer(H * 0.7, 9, 2, r() * 6) },
  { cls: 'dune-1', cols: layer(H * 0.86, 7, 2, r() * 6) },
];
const starPx = stars
  ? Array.from({ length: 90 }, () => ({ x: Math.floor(r() * W), y: Math.floor(r() * H * 0.5), big: r() > 0.9, tw: r() > 0.7 }))
  : [];
---
<svg class="sky" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin meet" shape-rendering="crispEdges" aria-hidden="true">
  {starPx.map((s) => (
    <rect x={s.x} y={s.y} width={s.big ? 2 : 1} height={s.big ? 2 : 1} class={s.tw ? 'star tw' : 'star'} />
  ))}
  <g class="moon moon-1">
    <rect x="252" y="10" width="8" height="2" /><rect x="250" y="12" width="12" height="8" /><rect x="252" y="20" width="8" height="2" />
    <rect x="254" y="14" width="2" height="2" class="crater" /><rect x="258" y="17" width="2" height="2" class="crater" />
  </g>
  <g class="moon moon-2">
    <rect x="281" y="24" width="4" height="1" /><rect x="280" y="25" width="6" height="4" /><rect x="281" y="29" width="4" height="1" />
  </g>
</svg>
<svg class="dunes" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax meet" shape-rendering="crispEdges" aria-hidden="true">
  {layers.map((l) => (
    <g class={l.cls}>
      {l.cols.map((c) => <rect x={c.x} y={c.y} width="2" height={H - c.y} />)}
    </g>
  ))}
</svg>
