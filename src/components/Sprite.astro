---
// Renders a character-grid sprite as a crisp SVG. Horizontal runs of the same colour are
// merged into one <rect>, so a 16x16 sprite is a few dozen nodes, not 256.
import { sprites } from '../data/sprites';

interface Props {
  name: string;
  size?: number; // CSS pixels per sprite pixel
  class?: string;
  label?: string;
}
const { name, size = 4, class: cls = '', label } = Astro.props;
// Each sprite's pixels are written once per page as a <symbol>; later copies only point at it.
const seen: Set<string> = ((Astro.locals as Record<string, unknown>).sprites ??= new Set<string>()) as Set<string>;
const key = sprites[name] ? name : 'worm';
const first = !seen.has(key);
seen.add(key);
const id = `spr-${key}`;
const grid = sprites[name] ?? sprites.worm;
const w = Math.max(...grid.map((r) => r.length));
const h = grid.length;
const rects: { x: number; y: number; w: number; c: string }[] = [];
grid.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    let run = 1;
    while (x + run < row.length && row[x + run] === c) run++;
    if (c !== '.') rects.push({ x, y, w: run, c });
    x += run;
  }
});
---
<svg
  class={`sprite ${cls}`}
  viewBox={`0 0 ${w} ${h}`}
  width={w * size}
  height={h * size}
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {first && <symbol id={id} viewBox={`0 0 ${w} ${h}`}>{rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" class={`px-${r.c}`} />)}</symbol>}
  <use href={`#${id}`} />
</svg>
