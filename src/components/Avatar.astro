---
// A person's 32x32 painted portrait, in both art styles; the top-bar switch shows one.
import type { Character } from '../data/cast';
import { lookIds } from '../lib/style';
interface Props { c: Pick<Character, 'id'>; size?: number; class?: string }
const { c, size = 4, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const px = 16 * size;
---
<span class={`avatar ${cls}`} style={`width:${px}px;height:${px}px`} aria-hidden="true">
  {lookIds.map((l) => <img class={`lk lk-${l}`} src={`${base}/art/${l}/p/${c.id}.png`} width={px} height={px} alt="" loading="lazy" decoding="async" />)}
</span>
