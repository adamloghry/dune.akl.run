---
// Procedural 16x16 pixel portrait built from a character's `look`.
// Layers: tile background (primary faction colour) → shoulders → head → hair/headwear → face.
import type { Character } from '../data/cast';
import { factionById } from '../data/cast';

interface Props { c: Character; size?: number; class?: string }
const { c, size = 4, class: cls = '' } = Astro.props;
const L = c.look;
const N = 16;
const g: (string | null)[][] = Array.from({ length: N }, () => Array(N).fill(null));
const set = (x: number, y: number, col: string) => { if (x >= 0 && x < N && y >= 0 && y < N) g[y][x] = col; };
const rect = (x0: number, y0: number, w: number, h: number, col: string) => { for (let y = y0; y < y0 + h; y++) for (let x = x0; x < x0 + w; x++) set(x, y, col); };

const ink = '#120a10';
const bg = factionById[c.factions[0]?.id]?.colour ?? '#444';
const shade = (hex: string, k: number) => {
  const n = parseInt(hex.slice(1), 16);
  const f = (v: number) => Math.max(0, Math.min(255, Math.round(v * k)));
  return `#${[f(n >> 16), f((n >> 8) & 255), f(n & 255)].map((v) => v.toString(16).padStart(2, '0')).join('')}`;
};

// background with a darker lower band
rect(0, 0, N, N, shade(bg, 0.55));
rect(0, 11, N, 5, shade(bg, 0.4));

// shoulders
rect(3, 13, 10, 3, L.cloth); rect(2, 14, 12, 2, L.cloth);
rect(7, 12, 2, 2, L.skin);

// head
const hw = L.wide ? 10 : 8; const hx = L.wide ? 3 : 4;
rect(hx, 4, hw, 8, L.skin);
rect(hx + 1, 3, hw - 2, 1, L.skin);
rect(hx + 1, 12, hw - 2, 1, L.skin);
if (L.wide) rect(hx - 1, 6, hw + 2, 4, L.skin);
// soft shading on the right cheek
rect(hx + hw - 1, 5, 1, 6, shade(L.skin, 0.85));

// hair / headwear
const hair = L.hair ?? ink;
switch (L.head) {
  case 'hair': rect(hx, 2, hw, 2, hair); rect(hx - 1, 3, 1, 3, hair); rect(hx + hw, 3, 1, 3, hair); break;
  case 'long': rect(hx, 2, hw, 2, hair); rect(hx - 1, 3, 1, 9, hair); rect(hx + hw, 3, 1, 9, hair); rect(hx - 2, 6, 1, 6, hair); rect(hx + hw + 1, 6, 1, 6, hair); break;
  case 'curly': for (let x = hx - 1; x <= hx + hw; x++) set(x, x % 2 ? 1 : 2, hair); rect(hx - 1, 2, hw + 2, 2, hair); rect(hx - 1, 4, 1, 2, hair); rect(hx + hw, 4, 1, 2, hair); break;
  case 'bald': set(hx + 2, 3, shade(L.skin, 1.12)); break;
  case 'crown': rect(hx, 2, hw, 2, hair); rect(hx, 1, hw, 1, '#ffcf4a'); set(hx, 0, '#ffcf4a'); set(hx + 3, 0, '#ffcf4a'); set(hx + hw - 1, 0, '#ffcf4a'); set(hx + 4, 1, '#c8452e'); break;
  case 'hood': case 'veil': {
    const robe = L.head === 'veil' ? '#151515' : L.cloth;
    rect(hx - 1, 1, hw + 2, 2, robe); rect(hx - 2, 3, 2, 10, robe); rect(hx + hw, 3, 2, 10, robe);
    rect(hx, 3, hw, 1, robe);
    break;
  }
  case 'stillsuit': {
    const suit = '#4a3a2a';
    rect(hx - 1, 1, hw + 2, 3, suit); rect(hx - 1, 4, 1, 8, suit); rect(hx + hw, 4, 1, 8, suit);
    rect(hx, 9, hw, 3, '#3a2e22'); // face mask
    set(hx + 1, 10, '#6b5a44'); set(hx + hw - 2, 10, '#6b5a44');
    rect(hx + hw + 1, 9, 1, 4, '#6b5a44'); // catch-tube
    break;
  }
  case 'worm': {
    const seg = '#8a6a4a'; const segD = '#5e4632';
    rect(0, 10, N, 6, seg);
    for (let x = 0; x < N; x += 3) rect(x, 10, 1, 6, segD);
    rect(hx - 1, 2, hw + 2, 2, hair);
    rect(hx - 2, 4, 1, 8, seg); rect(hx + hw + 1, 4, 1, 8, seg);
    break;
  }
}

// face
const eyeCol = L.eyes === 'blue' ? '#2a7fff' : L.eyes === 'white' ? '#f6ead2' : ink;
const ey = 7;
if (L.eyes !== 'none') {
  const ex1 = hx + 2, ex2 = hx + hw - 3;
  set(ex1, ey, eyeCol); set(ex2, ey, eyeCol);
  if (L.eyes === 'blue') { set(ex1 - 1, ey, '#7fb8ff'); set(ex2 + 1, ey, '#7fb8ff'); set(ex1, ey - 1, shade(L.skin, 0.7)); set(ex2, ey - 1, shade(L.skin, 0.7)); }
  else { set(ex1, ey - 1, shade(L.skin, 0.7)); set(ex2, ey - 1, shade(L.skin, 0.7)); }
}
if (L.head !== 'stillsuit') {
  set(hx + Math.floor(hw / 2) - 1, 8, shade(L.skin, 0.8));
  rect(hx + Math.floor(hw / 2) - 2, 10, 3, 1, shade(L.skin, 0.6));
}
// Mentat lips
if (c.factions.some((f) => f.id === 'mentats' && f.rel === 'member')) rect(hx + Math.floor(hw / 2) - 2, 10, 3, 1, '#a33a3a');

// merge horizontal runs
const rects: { x: number; y: number; w: number; c: string }[] = [];
g.forEach((row, y) => {
  let x = 0;
  while (x < N) {
    const col = row[x]; let run = 1;
    while (x + run < N && row[x + run] === col) run++;
    if (col) rects.push({ x, y, w: run, c: col });
    x += run;
  }
});
---
<svg class={`avatar ${cls}`} viewBox="0 0 16 16" width={16 * size} height={16 * size} shape-rendering="crispEdges" aria-hidden="true">
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.c} />)}
</svg>
