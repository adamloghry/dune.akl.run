---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import { eras, kindLabel, type Film, type FilmKind } from '../data/timeline';

const rows = eras.flatMap((era) =>
  era.events.flatMap((ev) => (ev.films ?? []).map((f) => ({ ...f, ev, era }))),
);
const kinds: FilmKind[] = ['changed', 'cut', 'added', 'kept'];
const count = (k: FilmKind) => rows.filter((r) => r.kind === k).length;
const films: { id: Film; title: string; year: string; scope: string }[] = [
  { id: 'PART ONE', title: 'Dune', year: '2021', scope: 'The first half of the novel: Caladan to the duel with Jamis.' },
  { id: 'PART TWO', title: 'Dune: Part Two', year: '2024', scope: 'The second half: the sietch years to the throne, compressed from about two years into months.' },
];
const order = (k: FilmKind) => kinds.indexOf(k);
---
<Base page="films" title="Book vs film — The Golden Path">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">the divergence ledger</p>
      <h1>Book vs film</h1>
      <p class="sec-sub">
        Every place where Villeneuve's two films change, cut, add to or deliberately keep Herbert's
        Dune. "Kept" is listed where a reader might expect a change. The pattern is consistent:
        the films move the book's later critique of the messiah forward, mostly through Chani.
      </p>
      <div class="stats">
        {kinds.map((k) => (
          <div class="stat pxbox"><b class={`k-${k}`}>{count(k)}</b><span>{kindLabel[k].toLowerCase()}</span></div>
        ))}
      </div>
    </header>

    {films.map((f) => {
      const fr = rows.filter((r) => r.film === f.id).sort((a, b) => order(a.kind) - order(b.kind));
      return (
        <section class="film-block" aria-labelledby={f.id}>
          <h2 id={f.id}><Sprite name="reel" size={3} />{f.title} <span class="vt" style="color: var(--ink-3); font-size: 0.8em">({f.year})</span></h2>
          <p class="sec-sub">{f.scope}</p>
          <table class="ledger pxbox">
            <thead><tr><th>Kind</th><th>In the book</th><th>On screen</th></tr></thead>
            <tbody>
              {fr.map((r) => (
                <tr>
                  <td><span class={`badge k-${r.kind}`}>{kindLabel[r.kind]}</span></td>
                  <td><a href={`../#${r.ev.id}`}>{r.ev.title}</a><br /><span class="vt" style="color: var(--ink-3); font-size: 18px">{r.ev.when}</span></td>
                  <td>{r.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      );
    })}

    <section class="prose">
      <h2>What the films don't reach</h2>
      <p>
        Everything after the Battle of Arrakeen on the chronicle comes from books Villeneuve has not
        yet put on screen. A third film drawn from Dune Messiah is not covered here; this ledger
        covers only the two released films. David Lynch's 1984 film and the television
        adaptations are out of scope by design.
      </p>
    </section>
  </div>
</Base>
