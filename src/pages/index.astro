---
import { lookIds } from '../lib/style';
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import EventCard from '../components/EventCard.astro';
import EUCard from '../components/EUCard.astro';
import { spineFor, euEvents, altNotes } from '../data/beyond-view';
import { eras, kindLabel } from '../data/timeline';
import { sp, eraLevel } from '../data/spoilers';
import type { EraId } from '../data/cast';

const colours = ['--rust', '--sand-d', '--spice', '--blue', '--sand', '--gold', '--dune-3', '--added'];
const total = eras.reduce((n, e) => n + (e.to - e.from), 0);
// Short eras get a floor so they remain clickable; the legend carries the real spans.
const ruler = eras.map((e, i) => {
  const pct = Math.max(1.6, ((e.to - e.from) / total) * 100);
  return { ...e, pct, colour: colours[i % colours.length], narrow: pct < 9 };
});
const land: Record<string, { label: string; sky: string; l: [string, string, string] }> = {
  'old-empire': { label: 'ARRAKIS · unsettled desert', sky: '#e9b06a', l: ['#d9964f', '#b8732f', '#8a5032'] },
  imperium: { label: 'ARRAKIS · desert and spice fields', sky: '#e9a85c', l: ['#d9964f', '#b8732f', '#8a5032'] },
  dune: { label: 'ARRAKIS · desert, secret plantings', sky: '#e39a52', l: ['#d9964f', '#a8853a', '#8a5032'] },
  messiah: { label: 'ARRAKIS · open water, first gardens', sky: '#dfa86a', l: ['#c9a050', '#8a9a4a', '#6b5a3a'] },
  children: { label: 'ARRAKIS · greening, worms retreating', sky: '#c9c08a', l: ['#9ab35a', '#7a8f4a', '#8a6a3a'] },
  'god-emperor': { label: 'ARRAKIS · green, save the Sareer', sky: '#8fc0e0', l: ['#4f8f4a', '#3a6f3a', '#c98a45'] },
  scattering: { label: 'ARRAKIS · the desert returns', sky: '#e0b070', l: ['#c9a050', '#a8853a', '#6b5a3a'] },
  heretics: { label: 'RAKIS · desert, then burned', sky: '#2a1418', l: ['#3a2a2a', '#5a3a2a', '#c8452e'] },
};
const motes = Array.from({ length: 18 }, (_, i) => ({ x: (i * 53) % 100, d: 9 + ((i * 7) % 8), delay: -((i * 13) % 17), dx: ((i % 5) - 2) * 30 }));
const filmCount = eras.flatMap((e) => e.events).flatMap((ev) => ev.films ?? []).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base page="home">
  <section class="hero">
    <div class="hero-art" aria-hidden="true">{lookIds.map((l) => <img class={`lk lk-${l}`} src={`${base}/art/${l}/hero.png`} width="480" height="120" alt="" />)}</div>
    <div class="motes" aria-hidden="true">{motes.map((m) => <i style={`--x:${m.x}%;--d:${m.d}s;--delay:${m.delay}s;--dx:${m.dx}px`}></i>)}</div>
    <div class="actor worm-rise"><div class="worm-body"><Sprite name="wormrise" size={5} /></div><div class="worm-spray"><Sprite name="breach" size={5} /></div></div>
    <div class="actor thopter-fly"><Sprite name="thopter" size={4} /></div>
    <div class="wrap hero-inner">
      <p class="kicker">a chronicle in {eras.length} eras</p>
      <h1>THE GOLDEN<br />PATH</h1>
      <p class="lede">More than fifteen thousand years of Frank Herbert's Dune</p>
      <div class="cta">
        <a class="btn" href="#old-empire">begin the record</a>
        <a class="btn ghost" href={`${base}/characters/`}>meet the people</a>
        <a class="btn ghost" href={`${base}/films/`}>{filmCount} film notes</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="ruler-sec" aria-labelledby="scale">
      <h2 id="scale" class="sec-title">The scale of it</h2>
      <p class="sec-sub">
        Each band is an era at its length in years. Dune and both films fit in a sliver two years wide.
        <a href={`${base}/scale/`}>See every event by year</a>.
      </p>
      <nav class="ruler" aria-label="Eras by length">
        {ruler.map((e) => (
          <a href={`#${e.id}`} class:list={{ narrow: e.narrow }} style={`flex: ${e.pct} 0 0; --c: var(${e.colour})`} title={`${e.name} · ${e.span}`}>
            <span>{e.num}</span>
          </a>
        ))}
      </nav>
      <ol class="ruler-legend">
        {ruler.map((e) => (
          <li style={`--c: var(${e.colour})`}><i></i><a href={`#${e.id}`}>{e.num} {e.name}</a></li>
        ))}
      </ol>
    </section>

    <div class="controls pxbox" role="group" aria-label="Display options">
      <label class="toggle"><input type="checkbox" id="show-films" checked /><span class="sw"></span>show film notes</label>
      <label class="toggle"><input type="checkbox" id="only-diverged" /><span class="sw"></span>only what the films touch</label>
      <label class="toggle"><input type="checkbox" id="show-eu" checked /><span class="sw"></span>later books ({euEvents.length})</label>
      <label class="toggle"><input type="checkbox" id="show-alt" /><span class="sw"></span>other screen versions ({altNotes.length})</label>
      <button type="button" class="shield-hint" data-open-shield>spoiler shield <span class="shield-now">off</span></button>
      <span class="era-now" aria-live="polite"></span>
      <div class="legend" aria-hidden="true">
        {(['kept', 'changed', 'cut', 'added'] as const).map((k) => <span class={`badge k-${k}`}>{kindLabel[k]}</span>)}
      </div>
    </div>

    {eras.map((era) => {
      const hasFilm = era.events.some((ev) => (ev.films ?? []).length > 0);
      return (
        <section id={era.id} class:list={['era', { 'has-film': hasFilm }]} aria-labelledby={`${era.id}-h`}>
          <header class="era-head pxbox">
            <div class="era-sprite"><Sprite name={era.sprite} size={5} /></div>
            <div>
              <span class="num" aria-hidden="true">{era.num}</span>
              <h2 id={`${era.id}-h`}>{era.name}</h2>
              <div class="span">{era.span}</div>
              <p {...sp(eraLevel[era.id as EraId])}>{era.summary}</p>
              <div class="books">{era.books.map((b) => <span class="book-tag">{b}</span>)}</div>
              <div class="era-land" style={`--sky:${land[era.id].sky}`}>
                {lookIds.map((l) => <img class={`lk lk-${l}`} src={`${base}/art/${l}/era/${era.id}.png`} width="320" height="80" loading="lazy" decoding="async" alt={`Arrakis in this era: ${land[era.id].label.split('·')[1]?.trim() ?? ''}`} />)}
                <span aria-hidden="true">{land[era.id].label}</span>
              </div>
            </div>
          </header>
          <ol class="spine">
            {(() => { let c = 0; return spineFor(era).map((it, i) => { const side = (i % 2 ? 's-r' : '') + (it.t === 'canon' && c++ % 2 ? ' c-r' : ''); return it.t === 'canon' ? <EventCard event={it.ev} side={side} /> : <EUCard event={it.ev} side={side} />; }); })()}
          </ol>
        </section>
      );
    })}
  </div>
  <script src="../scripts/home.js"></script>
</Base>
