---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
---
<Base title="Lost in the deep desert — The Golden Path">
  <div class="wrap page-head" style="text-align:center; padding: 80px 0">
    <div style="display:grid; place-items:center; margin-bottom: 20px"><Sprite name="worm" size={8} /></div>
    <p class="kicker">404 · no such sietch</p>
    <h1>Shai-Hulud took this page</h1>
    <p class="sec-sub" style="margin-inline:auto">Walk without rhythm, and head back to the <a href={import.meta.env.BASE_URL}>chronicle</a>.</p>
  </div>
</Base>
